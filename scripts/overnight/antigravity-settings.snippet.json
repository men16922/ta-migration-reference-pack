{
  "enableTerminalSandbox": true,
  "toolPermission": "proceed-in-sandbox",
  "permissions": {
    "allow": [
      "command(make check)",
      "command(make doc-budget)",
      "command(make test)",
      "command(make lint)",
      "command(make typecheck)",
      "command(make build)",
      "command(make smoke-local)",
      "command(npm test)",
      "command(npm run test)",
      "command(npm run lint)",
      "command(npm run typecheck)",
      "command(npm run build)",
      "command(git add)",
      "command(git commit)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git rev-parse)",
      "command(git restore)",
      "command(git checkout --)"
    ],
    "deny": [
      "command(git push)",
      "command(git reset --hard)",
      "command(rm -rf)",
      "command(sudo)",
      "command(curl)",
      "command(wget)",
      "command(make deploy)",
      "command(make publish)",
      "command(make release)",
      "command(make serve)",
      "command(make dev)",
      "command(npm run dev)",
      "command(npm start)",
      "command(aws)",
      "command(terraform)",
      "command(containerlab)",
      "command(docker)",
      "command(regex:make (db|infra)-.*)",
      "write_file(.git/)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)"
    ],
    "ask": []
  }
}
