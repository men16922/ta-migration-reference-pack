{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "ask",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "make deploy*": "deny",
      "make publish*": "deny",
      "make release*": "deny",
      "make serve*": "deny",
      "make dev*": "deny",
      "make db-*": "deny",
      "make infra-*": "deny",
      "npm run dev*": "deny",
      "npm start*": "deny",
      "aws *": "deny",
      "terraform *": "deny",
      "containerlab *": "deny",
      "docker *": "deny",
      "make check": "allow",
      "make doc-budget": "allow",
      "make test": "allow",
      "make lint": "allow",
      "make typecheck": "allow",
      "make build": "allow",
      "make smoke-local": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git restore *": "allow",
      "git checkout -- *": "allow",
      "python3 *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "touch scripts/overnight/*": "allow"
    }
  }
}
